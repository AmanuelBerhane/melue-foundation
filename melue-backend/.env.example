# ==============================================================================
# Melu-e Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env in this directory:
#   cp .env.example .env
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Rails Environment & Server Configuration
# ------------------------------------------------------------------------------
RAILS_ENV=development
PORT=3000
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Default credentials for local development. Adjust if using custom postgres user/password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Production / Cloud Database URL (Uncomment and configure in production)
# DATABASE_URL=postgresql://user:password@host:5432/melue_backend_production

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Defaults to Expo Web dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ------------------------------------------------------------------------------
# Push Notifications (Optional)
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) Server Key for mobile notifications
# FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here

# ------------------------------------------------------------------------------
# Production Encryption Keys (Required in production)
# ------------------------------------------------------------------------------
# Rails secret key base (generate with `bundle exec rails secret`)
# SECRET_KEY_BASE=your_generated_secret_key_base_here
