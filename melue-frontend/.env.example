# Base URL of the Melue Rails API (without the /api/v1 prefix).
# Use http://<your-lan-ip>:3000 when running on a physical tablet/device,
# and http://localhost:3000 for iOS Simulator / Android Emulator / web.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Development-only: when true, sign-in bypasses the backend and issues a local token.
# Set to false to hit the real API.
EXPO_PUBLIC_AUTH_MOCK=true